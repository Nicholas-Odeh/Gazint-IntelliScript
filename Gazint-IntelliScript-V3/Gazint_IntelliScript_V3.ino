// https://github.com/Nicholas-Odeh/Gazint-IntelliScript
// Gazint-IntelliScript-V2
// Made by Nicholas Odeh, for IT automation
//
// Target hardware: Arduino Pro Micro (ATmega32u4), SSD1306 128x32 I2C OLED
// on SDA=2 / SCL=3, three (or four) momentary push buttons.
//
// v3 changes from the original release:
//  - Switched from the stock Keyboard/Mouse libraries to HID-Project's
//    BootKeyboard/BootMouse.
//
//  - Buttons rewired in software to INPUT_PULLUP (button -> GND), so no
//    external pull resistors are required and unconnected/miswired pins
//    default safely to "not pressed" instead of floating.
//
//  - Added real edge-triggered debouncing.
//
//  - Fixed a silent integer-overflow bug: Mouse.move()/BootMouse.move()
//    take a signed char (-128..127). 
//
//  - Fixed "D:\Dell BIOS" -> "D:\\Dell BIOS".
//
//  - Switched to the explicit Adafruit_SSD1306(width, height, &Wire, reset)
//    constructor.

//  - Added an optional 4th button that opens a disk-partitioning helper
//    (Shift+F10 -> diskpart -> list disk) for technicians who need to wipe
//    a drive before installing Windows. 
//
// KNOWN LIMITATIONS:
//  - USB-C: the ATmega32u4 only speaks USB 2.0 Full-Speed signaling.
//
//  - This sketch cannot remove the USB CDC (virtual serial) interface.


#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <HID-Project.h>   // BootKeyboard / BootMouse (BIOS-compatible HID)

// ============================================================================
// USER CONFIGURATION -- edit only this block for normal setup/customization.
// ============================================================================

// Uncomment to enable USB-CDC serial debug logging. Leave commented out for
// field deployment: it adds flash/runtime overhead and is not needed for the
// device to function.
// #define DEBUG_SERIAL

// --- OLED display (SSD1306, I2C) ---
#define SCREEN_WIDTH   128
#define SCREEN_HEIGHT  32
#define OLED_RESET     4      // Pro Micro OLED shields commonly reset on D4
#define OLED_I2C_ADDR  0x3C   // pro micro OLED pins: 2 (SDA) & 3 (SCL)

// --- Button pins ---
// Wiring: each button connects the pin to GND. No external resistor needed;
// internal pull-ups are enabled in setup(). A disconnected pin reads HIGH
// ("not pressed"), so a wiring mistake fails safe instead of auto-firing.
const uint8_t buttonAPin = 8;   // Admin pass-key
const uint8_t buttonBPin = 7;   // BIOS driver location
const uint8_t buttonCPin = 10;  // BIOS key into Windows install
const uint8_t buttonDPin = 9;   // Disk wipe/reformat helper (diskpart)

// --- Timing ---
const uint16_t DEBOUNCE_MS       = 30;  // ignore contact bounce shorter than this
const uint16_t KEY_STEP_DELAY_MS = 15;  // delay between HID actions in a macro
const int8_t   MOUSE_JIGGLE_PX   = 100; // must stay within int8_t range (-128..127)
const uint16_t MOUSE_JIGGLE_DELAY_MS = 120;

// --- Secrets: fill these in before flashing a device for deployment. ---
// SECURITY WARNING: this device types these values in plaintext whenever the
// matching button is pressed, and they are stored in plaintext flash on the
// board. Anyone with physical possession of a flashed board can read or
// replay them (e.g. by dumping flash, or simply pressing the buttons). Treat
// a lost or stolen board as a compromise of every credential below and
// rotate them immediately. Do not reuse a domain admin password here if you
// can avoid it -- prefer a scoped local/service account with the minimum
// rights needed for imaging.
const char* ADMIN_PASSKEY     = "yourkeyhere";
const char* BIOS_DRIVER_PATH  = "D:\\Dell BIOS";
const char* WINDOWS_BIOS_KEY  = "Your BIOS Key";

// ============================================================================
// END USER CONFIGURATION
// ============================================================================

Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);
bool displayOk = false;

#ifdef DEBUG_SERIAL
  #define DEBUG_PRINTLN(x) Serial.println(x)
#else
  #define DEBUG_PRINTLN(x)
#endif

// Types used in function signatures below are declared here, near the top of
// the file. The Arduino build system auto-generates forward prototypes for
// every function defined in this .ino and inserts them immediately after the
// last #include, before anything else -- so any custom type (enum/struct)
// used as a parameter must be defined above this point, or the generated
// prototype won't compile.
enum Screen : uint8_t { SCREEN_NONE, SCREEN_IDLE, SCREEN_A, SCREEN_B, SCREEN_C, SCREEN_D };

struct Button {
  uint8_t pin;
  bool lastReading;
  bool stableState;
  unsigned long lastChangeMs;
};

