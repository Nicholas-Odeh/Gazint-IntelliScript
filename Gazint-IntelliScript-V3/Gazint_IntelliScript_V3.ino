// ---------------------------------------------------------------------------
// Debounced, edge-triggered button state
// ---------------------------------------------------------------------------
Button buttons[] = {
  { buttonAPin, HIGH, HIGH, 0 },
  { buttonBPin, HIGH, HIGH, 0 },
  { buttonCPin, HIGH, HIGH, 0 },
  { buttonDPin, HIGH, HIGH, 0 },
};
const uint8_t NUM_BUTTONS = sizeof(buttons) / sizeof(buttons[0]);

// Returns true exactly once per physical press (LOW = pressed, since pins
// use INPUT_PULLUP), after the signal has been stable for DEBOUNCE_MS. This
// replaces the original level-triggered check, which re-ran a button's
// entire macro on every ~50ms loop iteration for as long as it was held.
bool pressedEdge(Button &b) {
  bool reading = digitalRead(b.pin);
  if (reading != b.lastReading) {
    b.lastChangeMs = millis();
    b.lastReading = reading;
  }
  if ((millis() - b.lastChangeMs) > DEBOUNCE_MS && b.stableState != reading) {
    b.stableState = reading;
    if (b.stableState == LOW) return true;
  }
  return false;
}

// ---------------------------------------------------------------------------
// OLED helpers -- only push a new frame over I2C when the screen actually
// changes, instead of redrawing the same bitmap on every loop iteration.
// ---------------------------------------------------------------------------
Screen currentScreen = SCREEN_NONE;

void showBitmapScreen(Screen s, const uint8_t* bitmap) {
  if (!displayOk || s == currentScreen) return;
  display.clearDisplay();
  display.drawBitmap(0, 0, bitmap, SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
  display.display();
  currentScreen = s;
}

void showTextScreen(Screen s, const char* line1, const char* line2) {
  if (!displayOk || s == currentScreen) return;
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(WHITE);
  display.setCursor(0, 0);
  display.println(line1);
  if (line2 != nullptr) display.println(line2);
  display.display();
  currentScreen = s;
}

// ---------------------------------------------------------------------------
// Button macros
// ---------------------------------------------------------------------------

// Admin PASS-KEY hotkey (pin A = pin 8)
void runAdminPassKeyMacro() {
  DEBUG_PRINTLN("Button A pressed");
  showBitmapScreen(SCREEN_A, myBitmap2);
  BootMouse.click(MOUSE_LEFT);
  delay(KEY_STEP_DELAY_MS);
  BootKeyboard.print(ADMIN_PASSKEY); // sensitive: see SECURITY WARNING above
  delay(KEY_STEP_DELAY_MS);
  BootKeyboard.write(KEY_RETURN);
}

// BIOS driver location hotkey (pin B = pin 7)
void runBiosDriverMacro() {
  DEBUG_PRINTLN("Button B pressed");
  showBitmapScreen(SCREEN_B, myBitmap3);
  delay(25);
  BootMouse.click(MOUSE_LEFT); // left-click first to make sure the active window has focus
  BootKeyboard.press(KEY_LEFT_GUI);
  BootKeyboard.press('r');
  delay(KEY_STEP_DELAY_MS);
  BootKeyboard.releaseAll();
  delay(KEY_STEP_DELAY_MS);
  BootKeyboard.print(BIOS_DRIVER_PATH);
  delay(KEY_STEP_DELAY_MS);
  BootKeyboard.write(KEY_RETURN);
}

// BIOS key into Windows Install hotkey (pin C = pin 10)
void runWindowsBiosKeyMacro() {
  DEBUG_PRINTLN("Button C pressed");
  showBitmapScreen(SCREEN_C, myBitmap);
  delay(KEY_STEP_DELAY_MS);
  BootKeyboard.write(KEY_DOWN_ARROW);
  BootKeyboard.write(KEY_RETURN);
  BootKeyboard.print(WINDOWS_BIOS_KEY);
  BootKeyboard.write(KEY_RETURN);
  delay(20);
  // Jiggle the mouse (e.g. to keep a screen/session from timing out during a
  // long unattended install). Distance is kept within int8_t range -- the
  // original code passed +-200 here, which silently overflows a signed char
  // and moves the wrong distance/direction.
  BootMouse.move(-MOUSE_JIGGLE_PX, 0); delay(MOUSE_JIGGLE_DELAY_MS);
  BootMouse.move(MOUSE_JIGGLE_PX, 0);  delay(MOUSE_JIGGLE_DELAY_MS);
  BootMouse.move(0, -MOUSE_JIGGLE_PX / 5); delay(MOUSE_JIGGLE_DELAY_MS);
  BootMouse.move(0, MOUSE_JIGGLE_PX / 5);  delay(MOUSE_JIGGLE_DELAY_MS);
}

// Disk wipe/reformat helper hotkey (pin D = pin 9)
// Opens a command console and starts diskpart, then lists disks and STOPS.
// The destructive "select disk N" / "clean" commands are intentionally left
// for the technician to type by hand after reading the disk list, so this
// macro can never wipe the wrong drive if disk numbering differs from what
// was assumed (extra USB media plugged in, different drive order, etc.).
void runDiskWipeHelperMacro() {
  DEBUG_PRINTLN("Button D pressed");
  showTextScreen(SCREEN_D, "DISKPART", "Listing disks...");
  // Shift+F10 opens a command prompt directly inside Windows Setup/WinPE,
  // where there is no taskbar/Explorer for a Win+R "Run" dialog to work.
  BootKeyboard.press(KEY_LEFT_SHIFT);
  BootKeyboard.press(KEY_F10);
  delay(KEY_STEP_DELAY_MS);
  BootKeyboard.releaseAll();
  delay(500); // the cmd.exe console needs time to open before it can accept input
  BootKeyboard.print("diskpart");
  BootKeyboard.write(KEY_RETURN);
  delay(800); // diskpart.exe starts noticeably slower than cmd.exe itself
  BootKeyboard.print("list disk");
  BootKeyboard.write(KEY_RETURN);
  // Intentionally stops here -- see comment above.
}

// ---------------------------------------------------------------------------
void setup() {
#ifdef DEBUG_SERIAL
  Serial.begin(9600);
#endif

  pinMode(buttonAPin, INPUT_PULLUP);
  pinMode(buttonBPin, INPUT_PULLUP);
  pinMode(buttonCPin, INPUT_PULLUP);
  pinMode(buttonDPin, INPUT_PULLUP);

  displayOk = display.begin(SSD1306_SWITCHCAPVCC, OLED_I2C_ADDR);
  if (displayOk) {
    display.clearDisplay();
    display.display();
  }
  // If the OLED fails to initialize (e.g. a wiring fault), keyboard/mouse
  // automation -- the tool's actual job -- still runs; only the status
  // screen is lost. See showBitmapScreen()/showTextScreen()'s displayOk guard.

  BootKeyboard.begin();
  BootMouse.begin();
}

void loop() {
  showBitmapScreen(SCREEN_IDLE, myBitmap4); // no-op once already idle

  for (uint8_t i = 0; i < NUM_BUTTONS; i++) {
    if (pressedEdge(buttons[i])) {
      switch (i) {
        case 0: runAdminPassKeyMacro();     break;
        case 1: runBiosDriverMacro();       break;
        case 2: runWindowsBiosKeyMacro();   break;
        case 3: runDiskWipeHelperMacro();   break;
      }
      currentScreen = SCREEN_NONE; // force the idle screen to redraw next loop
    }
  }
}
