const unsigned char myBitmap3[] PROGMEM = {
};


void setup() {

  pinMode(pinA, INPUT);  // Button A (Pin 16)
  pinMode(pinB, INPUT);  // Button B (Pin 15)
  display.begin(SSD1306_SWITCHCAPVCC, 0x3C);  //I2C address
  display.clearDisplay();
  BootKeyboard.begin();
  BootMouse.begin();
}

void loop() {
  display.display();
  display.drawBitmap(0, 0, myBitmap1, 128, 32, WHITE); 
  display.display();
  delay(200);

//Admin Hotkey Button One 
  if (digitalRead(pinA) == HIGH) { //pinA = pin 16
    Serial.println("Button A pressed"); 
    display.clearDisplay();
    display.drawBitmap(0, 0, myBitmap2, 128, 32, WHITE); 
    display.display();
    delay(50);
    BootMouse.click(MOUSE_LEFT);
    display.display();
    delay(50);
    BootKeyboard.print("Button A pressed");
    delay(100);
    BootKeyboard.write(KEY_RETURN);
    delay(50);
    while (digitalRead(pinA) == HIGH);
    delay(150);
    display.clearDisplay();

  }

// Admin Hotkey Button Two 
if (digitalRead(pinB) == HIGH) { // pinB = pin 15
  Serial.println("Button B pressed"); //Serial monitor
  display.clearDisplay(); //Display refresh cycle
  display.drawBitmap(0, 0, myBitmap2, 128, 32, WHITE); //Bitmap selection 
  display.display();
  delay(50); //Delay timeframe in ms
  BootMouse.click(MOUSE_LEFT); //Left Click
  delay(50);
  BootKeyboard.print("Button B pressed"); //HID output
  delay(150);
  BootKeyboard.write(KEY_RETURN); //Enter button
  delay(50);
  BootKeyboard.write(KEY_DOWN_ARROW); //Down arrow key
  delay(50);
  BootMouse.move(-100, 0); //Move left 
  delay(50);
  BootMouse.move(100, 0); //Move right
  delay(50);
  BootMouse.move(0, -100); //Move up
  delay(50);
  BootMouse.move(0, 100); //Move down
  delay(50);
  while (digitalRead(pinB) == HIGH);
  delay(150); // Wait for button release
  display.clearDisplay();
}


